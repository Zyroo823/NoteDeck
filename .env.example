# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Gmail sign-in. Use a Google OAuth client of type Web application.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Required for Gmail sign-in. Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=""
# Optional recovery bootstrap: only a verified Gmail sign-in can claim this email as
# the first active administrator. Do not enable until the owner controls that Gmail.
BOOTSTRAP_ADMIN_EMAIL=""
